# Copy to .env and fill in. Never commit .env.

# Timezone for logs and the scheduler host.
TZ=America/Los_Angeles

# Contact details for the NWS User-Agent (they ask for an email or URL).
NWS_CONTACT=you@example.com

# Where the database, raw cache and backups live.
# (Docker sets DATA_DIR=/data itself; leave this for running without Docker.)
DATA_DIR=./data

# Cap on active locations; each uses about 150 Open-Meteo calls a day.
MAX_LOCATIONS=25

# Optional Healthchecks.io ping URLs: one check for forecast runs, one for backups.
HEALTHCHECKS_RUN_URL=
HEALTHCHECKS_BACKUP_URL=

# Push alerts (Web Push). `docker compose run --rm worker snowwatch push keys`
# prints both lines; leave them empty to keep alerts off. Never change them once
# phones have subscribed. See docs/RUNBOOK.md step 10.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Owner password for the Manage page (at least 12 characters). Leave empty to turn
# Manage off and use `snowwatch locations` instead. After changing it, run
# `docker compose run --rm worker snowwatch owner logout-all`.
OWNER_PASSWORD=

# The site's public address, e.g. https://snow.example.com (optional; helps the
# owner sign-in check requests when a proxy rewrites the Host header).
PUBLIC_URL=

# Set to 1 behind Cloudflare or a reverse proxy, so rate limits see each visitor's
# real address instead of the proxy's.
TRUSTED_PROXY=0

# An email for push services to reach you (falls back to NWS_CONTACT).
CONTACT_EMAIL=
