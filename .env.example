# Copy to .env and fill in. Never commit .env.

# Timezone for logs and the scheduler host.
TZ=America/Los_Angeles

# Contact details for the NWS User-Agent (they ask for an email or URL).
NWS_CONTACT=you@example.com

# Where the database, raw cache and backups live.
# (Docker sets DATA_DIR=/data itself; leave this for running without Docker.)
DATA_DIR=./data

# Cap on active locations; each uses about 150 Open-Meteo calls a day.
MAX_LOCATIONS=25

# Optional Healthchecks.io ping URLs: one check for forecast runs, one for backups.
HEALTHCHECKS_RUN_URL=
HEALTHCHECKS_BACKUP_URL=

# Push alerts (Web Push). `docker compose run --rm worker snowwatch push keys`
# prints both lines; leave them empty to keep alerts off. Never change them once
# phones have subscribed. See docs/RUNBOOK.md step 10.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Owner role and Cloudflare Access (milestone M4). Comma-separated.
ADMIN_EMAILS=
CF_ACCESS_TEAM=
CF_ACCESS_AUDS=

# Running locally without Cloudflare (npm run dev / uvicorn): set ENV=dev and an
# email from ADMIN_EMAILS here to act as the owner and open Manage locations.
# Ignored once CF_ACCESS_TEAM and CF_ACCESS_AUDS are set, and always in Docker.
# ENV=dev
# DEV_ADMIN_EMAIL=
