# Snow Watch settings. Copy to .env and fill in; never commit .env.
# docs/DEPLOYMENT.md explains each step.

# --- Required ------------------------------------------------------------------

# An email or URL for the US National Weather Service, which asks API users to
# identify themselves. It is sent only to NWS.
NWS_CONTACT=you@example.com

# The owner password for Manage locations: at least 12 characters. Leave empty
# to turn Manage off and use `snowwatch locations` instead. After changing it:
#   docker compose run --rm worker snowwatch owner logout-all
OWNER_PASSWORD=

# --- Behind a proxy or tunnel --------------------------------------------------

# The site's public address, e.g. https://snow.example.com.
PUBLIC_URL=

# 1 if a reverse proxy or Cloudflare is in front, so rate limits see each
# visitor's address. Leave 0 when the app is reached directly.
TRUSTED_PROXY=0

# --- Optional ------------------------------------------------------------------

# Timezone for logs.
TZ=America/Los_Angeles

# Most active locations; each uses about 150 Open-Meteo calls a day.
MAX_LOCATIONS=25

# Push alerts. `docker compose run --rm worker snowwatch push keys` prints both
# lines; leave them empty to keep alerts off. Never change them once devices have
# subscribed. CONTACT_EMAIL is how push services can reach you (defaults to
# NWS_CONTACT).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
CONTACT_EMAIL=

# Healthchecks.io ping URLs: one check for forecast runs, one for backups.
HEALTHCHECKS_RUN_URL=
HEALTHCHECKS_BACKUP_URL=

# Disk cap for the map tile cache (MB), and the most devices with alerts on.
# TILES_MAX_MB=2000
# PUSH_MAX_SUBSCRIPTIONS=500

# Where the database, caches and backups live when running without Docker
# (Docker uses /data, mounted from ./data).
# DATA_DIR=./data
